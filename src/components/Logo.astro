---
import { LOGO_LABEL, LOGO_TRACES, LOGO_VIEWBOX } from "./logo-traces";

interface Props {
  class?: string;
}
const { class: className = "h-7 w-auto" } = Astro.props;
---
<svg viewBox={LOGO_VIEWBOX} class={className} xmlns="http://www.w3.org/2000/svg" role="img" aria-label={LOGO_LABEL}>
  <g transform="translate(1 0)">
    {LOGO_TRACES.map((t) => <path fill={t.fill} fill-rule="evenodd" transform={t.transform} d={t.d} />)}
  </g>
</svg>
