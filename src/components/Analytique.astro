---
// Google Tag Manager, conteneur GTM-PW8SP69 (le même que l'ancien site, pour ne
// pas casser l'historique de mesure au moment de la bascule).
//
// Loi 25 : aucun témoin de mesure n'est déposé avant un consentement explicite.
// On s'appuie sur le mode consentement de Google (Consent Mode v2) : les
// balises se chargent, mais tout stockage reste « denied » tant que la personne
// n'a pas accepté dans la bannière (voir BanniereTemoins.astro).
//
// Le conteneur ne se charge qu'en production : ni en local, ni sur l'aperçu
// GitHub Pages, pour ne pas polluer les statistiques.
const GTM = "GTM-PW8SP69";
const { actif = false } = Astro.props;
---

{
  actif && (
    <Fragment>
      <script is:inline define:vars={{ GTM }}>
        // `define:vars` enferme ce script dans une fonction : on accroche donc
        // gtag explicitement à window, sinon la bannière de consentement ne
        // pourrait pas l'appeler pour mettre le consentement à jour.
        window.dataLayer = window.dataLayer || [];
        window.gtag = function () {
          window.dataLayer.push(arguments);
        };
        var gtag = window.gtag;

        // État par défaut : tout refusé. Doit être poussé AVANT le conteneur.
        gtag("consent", "default", {
          ad_storage: "denied",
          ad_user_data: "denied",
          ad_personalization: "denied",
          analytics_storage: "denied",
          functionality_storage: "granted",
          security_storage: "granted",
          wait_for_update: 500,
        });

        // Rejouer un consentement déjà donné lors d'une visite précédente.
        try {
          if (localStorage.getItem("cfrq-temoins") === "accepte") {
            gtag("consent", "update", {
              ad_storage: "granted",
              ad_user_data: "granted",
              ad_personalization: "granted",
              analytics_storage: "granted",
            });
          }
        } catch (e) {
          /* stockage bloqué par le navigateur : on reste sur « denied » */
        }

        // Conteneur GTM.
        (function (w, d, s, l, i) {
          w[l] = w[l] || [];
          w[l].push({ "gtm.start": new Date().getTime(), event: "gtm.js" });
          var f = d.getElementsByTagName(s)[0],
            j = d.createElement(s),
            dl = l != "dataLayer" ? "&l=" + l : "";
          j.async = true;
          j.src = "https://www.googletagmanager.com/gtm.js?id=" + i + dl;
          f.parentNode.insertBefore(j, f);
        })(window, document, "script", "dataLayer", GTM);
      </script>
    </Fragment>
  )
}
