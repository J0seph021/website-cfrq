---
// Google Analytics 4, propriété « CFRQ » (compte 267159722, propriété 550578747,
// flux « Site cfrq.ca »). Chargement direct de gtag.js, sans Google Tag Manager.
//
// Pourquoi sans GTM : le conteneur GTM-PW8SP69 repris de l'ancien site
// alimentait la propriété GA4 G-6JE2CNCNNM, qui appartient à un tiers non
// identifié. CFRQ n'en recevait aucune donnée, et les visiteurs étaient mesurés
// par quelqu'un d'autre que celui annoncé dans la politique de confidentialité.
// Une couche d'indirection qu'on ne contrôle pas est une couche de trop.
//
// Loi 25 : aucun témoin de mesure n'est déposé avant un consentement explicite.
// Le mode consentement de Google (Consent Mode v2) est initialisé à « denied »
// dans le script en ligne, qui s'exécute AVANT le chargement asynchrone de
// gtag.js. La bannière le passe à « granted » si la personne accepte
// (voir BanniereTemoins.astro).
//
// Ne se charge qu'en production : ni en local, ni en préproduction, pour ne pas
// polluer les statistiques (voir analytiqueActive() dans data/flags.ts).
import { ID_MESURE } from "../data/flags";

const { actif = false } = Astro.props;
---

{
  actif && ID_MESURE && (
    <Fragment>
      <script is:inline define:vars={{ ID_MESURE }}>
        // `define:vars` enferme ce script dans une fonction : on accroche donc
        // gtag explicitement à window, sinon la bannière de consentement ne
        // pourrait pas l'appeler pour mettre le consentement à jour.
        window.dataLayer = window.dataLayer || [];
        window.gtag = function () {
          window.dataLayer.push(arguments);
        };
        var gtag = window.gtag;

        // État par défaut : tout refusé. Doit être poussé AVANT gtag.js.
        gtag("consent", "default", {
          ad_storage: "denied",
          ad_user_data: "denied",
          ad_personalization: "denied",
          analytics_storage: "denied",
          functionality_storage: "granted",
          security_storage: "granted",
          wait_for_update: 500,
        });

        // Rejouer un consentement déjà donné lors d'une visite précédente.
        try {
          if (localStorage.getItem("cfrq-temoins") === "accepte") {
            gtag("consent", "update", {
              ad_storage: "granted",
              ad_user_data: "granted",
              ad_personalization: "granted",
              analytics_storage: "granted",
            });
          }
        } catch (e) {
          /* stockage bloqué par le navigateur : on reste sur « denied » */
        }

        gtag("js", new Date());
        gtag("config", ID_MESURE);
      </script>

      <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${ID_MESURE}`} />
    </Fragment>
  )
}
