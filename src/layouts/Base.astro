---
import "@fontsource-variable/fraunces";
import "@fontsource-variable/inter";
import "../styles/global.css";
import frauncesLatin from "@fontsource-variable/fraunces/files/fraunces-latin-wght-normal.woff2?url";
import Analytique from "../components/Analytique.astro";
import BanniereTemoins from "../components/BanniereTemoins.astro";
import { analytiqueActive, estProduction } from "../data/flags";

interface Props {
  title?: string;
  description?: string;
  /** Chemin canonique (ex. "/services/"). Par défaut : chemin courant. */
  canonical?: string;
  /** Directive robots. Ex. "noindex, follow" pour les pages privées. */
  robots?: string;
  /** Image Open Graph (chemin absolu ou relatif au site). Par défaut : og-cfrq.jpg. */
  ogImage?: string;
}

const {
  title = "CFRQ, Conseillers forestiers de la région de Québec",
  description = "Des ingénieurs forestiers indépendants pour protéger, aménager et mettre en valeur votre boisé, partout au Québec.",
  canonical,
  robots,
  // Image d'aperçu par défaut sur Facebook, LinkedIn, Messenger, Teams,
  // iMessage et Slack. Sans elle, ces réseaux affichent un rectangle gris à la
  // place du lien. Régénérable : node scripts/generer-og-image.mjs
  ogImage = "/og-cfrq.jpg",
} = Astro.props;

// URL canonique absolue à partir de Astro.site (configuré dans astro.config.mjs).
const siteOrigin = (Astro.site ?? new URL("https://cfrq.ca")).origin;
const canonicalPath = canonical ?? Astro.url.pathname;
const canonicalUrl = new URL(canonicalPath, siteOrigin).href;
const ogImageUrl = ogImage ? new URL(ogImage, siteOrigin).href : undefined;

// Seule la production s'indexe. La préproduction et l'aperçu GitHub Pages
// servent le même contenu : les laisser indexer créerait du contenu dupliqué
// avec cfrq.ca. Le robots.txt applique la même règle (src/pages/robots.txt.ts).
const production = estProduction(siteOrigin);
const robotsFinal = robots ?? (production ? undefined : "noindex, follow");

const mesureActive = analytiqueActive(siteOrigin);
---

<!doctype html>
<html lang="fr-CA">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {robotsFinal && <meta name="robots" content={robotsFinal} />}
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL.replace(/\/$/, "")}/favicon.svg`} />

    {/* Les deux fontes réellement utilisées au premier écran. Sans ce
        préchargement, le navigateur ne les découvre qu'après avoir lu la
        feuille de style : le texte s'affiche d'abord en police système puis
        saute (décalage de mise en page mesuré à 0,10 sur /notre-equipe/). */}
    <link rel="preload" as="font" type="font/woff2" href={frauncesLatin} crossorigin />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content="fr_CA" />
    {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}
    {ogImageUrl && <meta property="og:image:width" content="1200" />}
    {ogImageUrl && <meta property="og:image:height" content="630" />}
    {ogImageUrl && <meta property="og:image:alt" content="Boisé privé du territoire desservi par CFRQ, avec le logo de CFRQ" />}
    <meta property="og:site_name" content="CFRQ" />

    <meta name="twitter:card" content={ogImageUrl ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImageUrl && <meta name="twitter:image" content={ogImageUrl} />}

    <Analytique actif={mesureActive} />

    <slot name="head" />
  </head>
  <body class="font-body text-cfrq-ink">
    <a
      href="#contenu"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:bg-cfrq-deep focus:px-4 focus:py-2 focus:text-cfrq-cream"
    >
      Aller au contenu
    </a>
    <slot />
    {mesureActive && <BanniereTemoins />}
  </body>
</html>
