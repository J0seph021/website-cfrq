---
// Page publique servie à /espace-client TANT QUE l'espace client n'est pas
// ouvert (PUBLIER_ESPACE_CLIENT != 1). Le bouton « Espace client » du menu
// mène ici : plutôt qu'un lien mort ou un bouton absent, le visiteur
// comprend ce que sera l'espace client et apprend qu'il est en construction.
//
// Quand le drapeau passe à 1, la vraie page de connexion prend cette adresse
// et cette page-ci disparaît du site (voir l'injection dans astro.config.mjs).
import Base from "../../layouts/Base.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import CTASection from "../../components/CTASection.astro";
import { site } from "../../data/site";
import { withBase } from "../../lib/url";

const atouts = [
  {
    titre: "Votre forêt sur une carte",
    texte:
      "Vos lots, leurs peuplements et les essences qui les composent, sur une carte que vous pouvez explorer vous-même.",
  },
  {
    titre: "Vos documents au même endroit",
    texte:
      "Plan d'aménagement, prescriptions, rapports : téléchargeables en tout temps, sans fouiller dans vos vieux courriels.",
  },
  {
    titre: "Vos travaux, du début à la fin",
    texte:
      "Ce qui a été réalisé dans votre boisé, ce qui est prévu, et ce que votre forêt demande pour les prochaines années.",
  },
  {
    titre: "Vos rapports de taxes foncières",
    texte:
      "Le rapport annuel préparé par nos ingénieurs forestiers pour votre remboursement de taxes, prêt à remettre à votre comptable.",
  },
  {
    titre: "Votre parcours forestier",
    texte:
      "L'historique de votre boisé avec CFRQ, année par année : les visites, les interventions, les documents produits.",
  },
  {
    titre: "Le portrait de votre boisé",
    texte:
      "Sa valeur en bois, le carbone qu'il stocke, son potentiel acéricole et ses leviers fiscaux. Des chiffres propres à votre forêt.",
  },
];

const eyebrow = "text-[12.5px] font-semibold uppercase tracking-[0.18em]";
const lienSouligne = "font-semibold text-cfrq-deep underline underline-offset-2";
---

<Base
  title="Espace client, en construction | CFRQ"
  description="L'espace client CFRQ réunira vos documents, les cartes de votre boisé et le suivi de vos travaux forestiers. Il est en construction : voici ce qu'il contiendra."
  robots="noindex, follow"
>
  <Header />
  <main id="contenu">
    <!-- EN-TÊTE : ce que c'est, et l'état du chantier, dès le premier écran -->
    <section style="background:linear-gradient(160deg,#EAF4E0,#F7F5EE 60%)">
      <div class="mx-auto max-w-[1160px] px-[22px] pb-14 pt-16">
        <span class="inline-flex items-center gap-2 rounded-full bg-cfrq-green px-3.5 py-[6px] text-[11.5px] font-bold uppercase tracking-[0.12em] text-[#123005]">
          <span class="h-[7px] w-[7px] flex-none rounded-full bg-[#123005]" aria-hidden="true"></span>
          En construction
        </span>
        <p class={`mt-5 ${eyebrow} text-cfrq-leaf`}>Espace client</p>
        <h1 class="mt-3 font-display font-medium text-cfrq-deep text-[clamp(34px,5.5vw,50px)] leading-[1.04] tracking-[-0.02em] text-balance">
          Votre boisé, en ligne
        </h1>
        <p class="mt-5 max-w-[600px] text-[17.5px] leading-[1.55] text-cfrq-ink/70">
          L'espace client, c'est le dossier de votre forêt accessible en tout temps : vos documents,
          les cartes de votre propriété et le suivi de vos travaux, réunis dans une seule page qui
          vous appartient.
        </p>
        <p class="mt-4 max-w-[600px] text-[17px] leading-[1.55] text-cfrq-ink/70">
          <strong class="font-semibold text-cfrq-deep">Il est encore en construction.</strong>
          Nous finissons de le mettre au point avant de l'ouvrir à nos clients : vous ne pouvez donc
          pas encore vous y connecter.
        </p>
      </div>
    </section>

    <!-- CE QU'IL CONTIENDRA : la partie « c'est quoi, l'espace client » -->
    <section class="mx-auto max-w-[1160px] px-[22px] pb-4 pt-[60px]">
      <h2 class="font-display text-[clamp(26px,3.6vw,34px)] font-medium leading-[1.1] tracking-[-0.015em] text-cfrq-deep text-balance">
        Ce que vous y trouverez
      </h2>
      <p class="mt-3 max-w-[620px] text-[16.5px] leading-relaxed text-cfrq-ink/65">
        Tout ce que nos ingénieurs forestiers produisent pour vous, rassemblé au même endroit
        plutôt qu'éparpillé entre les courriels, les cartes papier et les classeurs.
      </p>
      <ul class="mt-8 grid gap-3.5 sm:grid-cols-2 lg:grid-cols-3">
        {atouts.map((a) => (
          <li class="h-full rounded-2xl border border-black/5 bg-white p-6">
            <span class="mb-3.5 block h-[9px] w-[9px] rounded-full bg-cfrq-green" aria-hidden="true"></span>
            <h3 class="font-display text-[19.5px] font-medium leading-snug text-cfrq-deep">{a.titre}</h3>
            <p class="mt-2 text-[14.5px] leading-relaxed text-cfrq-ink/65">{a.texte}</p>
          </li>
        ))}
      </ul>
    </section>

    <!-- OÙ EN EST LE CHANTIER : dire honnêtement l'état, sans promettre de date -->
    <section class="mx-auto max-w-[1160px] px-[22px] pb-4 pt-[52px]">
      <div class="rounded-3xl border border-cfrq-green/20 p-[clamp(26px,4vw,44px)]" style="background:linear-gradient(140deg,#EAF4E0,#FFFFFF 66%)">
        <h2 class="font-display text-[clamp(24px,3.4vw,32px)] font-medium leading-[1.1] tracking-[-0.015em] text-cfrq-deep">
          Où en est le chantier
        </h2>
        <p class="mt-4 max-w-[640px] text-[16.5px] leading-[1.6] text-cfrq-ink/70">
          L'espace client existe déjà et il fonctionne. Nous le mettons au point boisé par boisé,
          parce qu'un dossier forestier doit être exact avant d'être publié : les superficies, les
          peuplements et l'historique des travaux affichés doivent être les vôtres, pas une
          approximation.
        </p>
        <p class="mt-3.5 max-w-[640px] text-[16.5px] leading-[1.6] text-cfrq-ink/70">
          Nous préférons ne pas annoncer de date : il ouvrira quand il sera solide.
          Vous voulez être parmi les premiers à y accéder ? Écrivez-nous à
          <a href={`mailto:${site.courriel}`} class={lienSouligne}>{site.courriel}</a>
          et nous vous ferons signe dès l'ouverture.
        </p>
      </div>
    </section>

    <!-- EN ATTENDANT : personne ne repart les mains vides -->
    <section class="mx-auto max-w-[1160px] px-[22px] pb-[60px] pt-[52px]">
      <h2 class="font-display text-[clamp(24px,3.4vw,32px)] font-medium leading-[1.1] tracking-[-0.015em] text-cfrq-deep">
        En attendant, rien ne change
      </h2>
      <div class="mt-6 grid gap-3.5 md:grid-cols-3">
        <div class="rounded-2xl bg-cfrq-tint p-6">
          <h3 class="font-display text-[19px] font-medium text-cfrq-deep">Vos documents</h3>
          <p class="mt-2 text-[14.5px] leading-relaxed text-cfrq-ink/70">
            Vos plans, prescriptions et rapports continuent de vous parvenir par courriel, comme
            d'habitude. Une copie s'est perdue ? Demandez-la-nous, on vous la renvoie.
          </p>
        </div>
        <div class="rounded-2xl bg-cfrq-tint p-6">
          <h3 class="font-display text-[19px] font-medium text-cfrq-deep">Une question sur votre dossier</h3>
          <p class="mt-2 text-[14.5px] leading-relaxed text-cfrq-ink/70">
            Votre ingénieur forestier répond au
            <a href={site.telHref} class={lienSouligne}>{site.tel}</a>. C'est encore la façon la plus
            rapide d'avoir une réponse claire.
          </p>
        </div>
        <div class="rounded-2xl bg-cfrq-tint p-6">
          <h3 class="font-display text-[19px] font-medium text-cfrq-deep">Un nouveau projet</h3>
          <p class="mt-2 text-[14.5px] leading-relaxed text-cfrq-ink/70">
            Une visite-conseil de votre boisé reste le meilleur point de départ.
            <a href={withBase("/contact")} class={lienSouligne}>Prenez rendez-vous</a>, sans engagement.
          </p>
        </div>
      </div>
    </section>
  </main>

  <CTASection
    title="Une question sur votre boisé ?"
    text="Pas besoin d'attendre l'espace client : nos ingénieurs forestiers vous répondent directement."
    ctaLabel="Nous joindre"
  />
  <Footer />
</Base>
