---
// Page servie par GitHub Pages pour toute URL inconnue.
// Elle compte : les URL de l'ancien site qui ne sont pas dans la table de
// redirections (vieux imprimés, liens externes, coquilles) atterrissent ici.
// L'objectif est de renvoyer la personne vers la bonne page plutôt que de la
// laisser sur une erreur brute.
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { site } from "../data/site";
import { withBase } from "../lib/url";
import { services } from "../data/services";

const pistes = [
  { label: "Tous nos services", href: "/services/", texte: "Aménagement, récolte, évaluation, érablière, arboriculture." },
  { label: "Territoire desservi", href: "/territoire-desservi/", texte: "Les régions où nos équipes se déplacent." },
  { label: "Notre équipe", href: "/notre-equipe/", texte: "Les ingénieurs forestiers et techniciens derrière CFRQ." },
  { label: "Nous joindre", href: "/contact/", texte: "Réserver une visite-conseil de votre boisé." },
];
---

<Base
  title="Page introuvable | CFRQ"
  description="Cette page n'existe pas ou a été déplacée. Retrouvez nos services forestiers, notre territoire et nos coordonnées."
  robots="noindex, follow"
>
  <Header />
  <main id="contenu">
    <section style="background:linear-gradient(160deg,#EAF4E0,#F7F5EE 60%)">
      <div class="mx-auto max-w-[820px] px-[22px] pb-12 pt-16">
        <p class="text-[12.5px] font-semibold uppercase tracking-[0.2em] text-cfrq-leaf">Erreur 404</p>
        <h1 class="mt-3.5 font-display font-medium text-cfrq-deep text-[clamp(34px,5.5vw,50px)] leading-[1.04] tracking-[-0.02em] text-balance">
          Cette page n'existe plus
        </h1>
        <p class="mt-4 max-w-[560px] text-[17px] leading-[1.55] text-cfrq-ink/65">
          Le site de CFRQ a été refait. Il se peut que le lien que vous avez suivi pointe vers une ancienne
          adresse. Voici où retrouver ce que vous cherchiez.
        </p>
      </div>
    </section>

    <section class="mx-auto max-w-[820px] px-[22px] pb-6 pt-12">
      <ul class="grid gap-3 sm:grid-cols-2">
        {pistes.map((p) => (
          <li>
            <a
              href={withBase(p.href)}
              class="block h-full rounded-2xl border border-black/5 bg-white p-5 transition-colors hover:border-cfrq-green/40"
            >
              <span class="font-display text-[19px] font-medium text-cfrq-deep">{p.label}</span>
              <span class="mt-1.5 block text-[14px] leading-relaxed text-cfrq-ink/60">{p.texte}</span>
            </a>
          </li>
        ))}
      </ul>

      <h2 class="mt-12 font-display text-[22px] font-medium text-cfrq-deep">Nos services en détail</h2>
      <ul class="mt-4 flex flex-wrap gap-2.5">
        {services.map((s) => (
          <li>
            <a
              href={withBase(`/${s.slug}/`)}
              class="inline-flex rounded-full border border-cfrq-green/30 bg-white px-4 py-2 text-[14px] text-cfrq-deep transition-colors hover:bg-cfrq-tint"
            >
              {s.titre}
            </a>
          </li>
        ))}
      </ul>

      <p class="mt-12 rounded-2xl bg-cfrq-tint p-6 text-[16px] leading-relaxed text-cfrq-ink/75">
        Vous ne trouvez pas ? Appelez-nous au
        <a href={site.telHref} class="font-semibold text-cfrq-deep underline underline-offset-2">{site.tel}</a>
        ou écrivez à
        <a href={`mailto:${site.courriel}`} class="font-semibold text-cfrq-deep underline underline-offset-2">{site.courriel}</a>.
      </p>
    </section>
  </main>
  <Footer />
</Base>
