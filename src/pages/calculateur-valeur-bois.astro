---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import WoodValueCalculator from "../components/WoodValueCalculator.tsx";
import { SITE_PRODUCTION } from "../data/flags";

// Outil gratuit et public : déclaré en `WebApplication`, il peut apparaître
// comme outil dans Google plutôt que comme simple page de texte. Le fil
// d'Ariane le rattache à l'accueil.
const ld = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["WebPage", "WebApplication"],
      "@id": `${SITE_PRODUCTION}/calculateur-valeur-bois/#webpage`,
      url: `${SITE_PRODUCTION}/calculateur-valeur-bois/`,
      name: "Calculateur de valeur du bois",
      description:
        "Estimez ce que le bois de votre forêt vous rapporte vraiment : la valeur marchande, moins le transport et la récolte.",
      inLanguage: "fr-CA",
      applicationCategory: "FinanceApplication",
      browserRequirements: "Fonctionne dans tout navigateur récent, sans installation.",
      isAccessibleForFree: true,
      offers: { "@type": "Offer", price: "0", priceCurrency: "CAD" },
      provider: { "@id": `${SITE_PRODUCTION}/#organization` },
      publisher: { "@id": `${SITE_PRODUCTION}/#organization` },
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Accueil", item: `${SITE_PRODUCTION}/` },
        {
          "@type": "ListItem",
          position: 2,
          name: "Calculateur de valeur du bois",
          item: `${SITE_PRODUCTION}/calculateur-valeur-bois/`,
        },
      ],
    },
  ],
};
---

<Base
  title="Calculateur de valeur du bois | CFRQ"
  description="Estimez ce que le bois de votre forêt vous rapporte vraiment : la valeur marchande, moins le transport et la récolte. Ajustez vos hypothèses."
  canonical="/calculateur-valeur-bois/"
>
  <script type="application/ld+json" set:html={JSON.stringify(ld)} slot="head" />

  <Header />
  <main id="contenu">
    <section class="bg-[#f4f5f2]">
      <div class="mx-auto max-w-[1160px] px-[22px] py-[72px]">
        <div class="max-w-[720px]">
          <p class="text-[13px] font-semibold uppercase tracking-[0.14em] text-cfrq-leaf">Outil gratuit · estimation</p>
          <h1 class="mt-3.5 font-display text-[clamp(28px,5vw,42px)] font-medium leading-[1.08] text-cfrq-deep">
            Combien vaut vraiment le bois de votre forêt ?
          </h1>
          <p class="mt-4 text-[17px] leading-relaxed text-cfrq-ink/65">
            Le prix affiché à l'usine n'est pas ce qui reste dans vos poches : il faut en retirer le transport et la récolte.
            Entrez vos volumes, ajustez le coût de récolte selon votre type de coupe, et voyez la valeur nette, celle qui vous revient.
          </p>
        </div>
        <div class="mt-8">
          <WoodValueCalculator client:load />
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Base>
