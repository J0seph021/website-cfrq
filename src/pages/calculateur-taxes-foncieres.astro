---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import CalculateurTaxesRTF from "../components/CalculateurTaxesRTF.tsx";
import { withBase } from "../lib/url";
import { ANNEE_GRILLE } from "../data/rtf";
---

<Base
  title="Calculateur de remboursement des taxes foncières | CFRQ"
  description={`Tous les taux de la grille ${ANNEE_GRILLE} du MRNF, le calcul du remboursement des taxes foncières des producteurs forestiers reconnus et un rapport imprimable pour le propriétaire.`}
>
  <Header />
  <main id="contenu">
    <section class="bg-[#f4f5f2]">
      <div class="mx-auto max-w-[1320px] px-[22px] py-[72px]">
        <div class="rtf-ecran-seulement max-w-[760px]">
          <p class="text-[13px] font-semibold uppercase tracking-[0.14em] text-cfrq-leaf">
            Outil de travail · grille {ANNEE_GRILLE}
          </p>
          <h1 class="mt-3.5 font-display text-[clamp(28px,5vw,42px)] font-medium leading-[1.08] text-cfrq-deep">
            Combien vos travaux vous rendent-ils en taxes ?
          </h1>
          <p class="mt-4 text-[17px] leading-relaxed text-cfrq-ink/65">
            Le remboursement des taxes foncières ne dépend pas de vos taxes seules : il dépend des
            travaux d'aménagement que vous faites. Choisissez les traitements, entrez vos comptes de
            taxes municipales et scolaires, et obtenez un rapport imprimable qui montre ce que vous
            récupérez, cette année et sur dix ans.
          </p>
          <p class="mt-3 text-[14px] text-cfrq-ink/60">
            Vous cherchez plutôt un ordre de grandeur en trente secondes ?
            <a href={withBase("/")} class="font-medium text-cfrq-leaf underline">
              Le calculateur simple est sur l'accueil →
            </a>
          </p>
        </div>

        <div class="mt-9">
          <CalculateurTaxesRTF client:load />
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Base>

<style is:global>
  /* Ce qui n'existe qu'à l'écran, et ce qui n'existe qu'au papier. */
  .rtf-impression-seulement {
    display: none;
  }

  @media print {
    /* Le bouton « Imprimer en PDF » n'appelle rien d'autre que window.print() :
       toute la mise en page du PDF se joue ici. */
    @page {
      margin: 14mm;
    }

    /* Tout ce qui n'est pas le rapport disparaît : chrome du site, colonne de
       saisie, fil d'intro. Le lecteur reçoit un document, pas une capture. */
    header,
    footer,
    .rtf-ecran-seulement {
      display: none !important;
    }

    .rtf-impression-seulement {
      display: block !important;
    }

    html,
    body {
      background: #fff !important;
    }

    main,
    main section {
      background: #fff !important;
    }

    main section > div {
      max-width: none !important;
      padding: 0 !important;
    }

    /* La grille deux colonnes n'a plus de raison d'être : le rapport prend la
       feuille entière. */
    .rtf-rapport {
      display: block !important;
      border: 0 !important;
      border-radius: 0 !important;
      box-shadow: none !important;
      padding: 0 !important;
      margin: 0 !important;
      width: 100% !important;
      max-width: none !important;
    }

    /* Les aplats verts ne survivent pas à l'impression par défaut : on les force,
       sinon les deux chiffres qui comptent arrivent sur fond blanc sans cadre. */
    .rtf-rapport [class*="bg-cfrq-tint"],
    .rtf-rapport [class*="bg-cfrq-cream"] {
      -webkit-print-color-adjust: exact;
      print-color-adjust: exact;
    }

    /* Une section, un bloc : pas de titre orphelin en bas de page ni de tableau
       coupé en deux au milieu d'une ligne. */
    .rtf-rapport section,
    .rtf-rapport table {
      break-inside: avoid-page;
    }

    .rtf-rapport tr {
      break-inside: avoid;
    }

    .rtf-rapport h3,
    .rtf-rapport h4 {
      break-after: avoid;
    }

    /* Les liens de source restent lisibles, mais discrets. */
    .rtf-rapport a {
      color: inherit !important;
      text-decoration: underline;
    }
  }
</style>
