---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import EnteteImage from "../../components/EnteteImage.astro";
import Base from "../../layouts/Base.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { site } from "../../data/site";
import { withBase } from "../../lib/url";
import { SITE_PRODUCTION } from "../../data/flags";
import { AGENCES } from "../../data/agences";
import {
  PAGES_MUNICIPALES,
  FAMILLES,
  PROFIL,
  MRC_INFO,
  ANNEE_DONNEES,
  travauxTries,
  voisines,
  type PageMunicipale,
  type FamilleTravaux,
} from "../../data/pagesMunicipales";

import erabliere from "../../assets/photos/erabliere.jpg";
import recolteBois from "../../assets/photos/recolte-bois.jpg";
import recolteHiver from "../../assets/photos/recolte-hiver.jpg";
import plantationErables from "../../assets/photos/plantation-erables.jpg";
import peuplement from "../../assets/photos/peuplement.jpg";
import planAmenagement from "../../assets/photos/plan-amenagement.jpg";

import phSimonProulx from "../../assets/photos/equipe/simon-proulx.jpg";
import phChristianDumont from "../../assets/photos/equipe/christian-dumont.jpg";
import phJeanBenoitGirard from "../../assets/photos/equipe/jean-benoit-girard.jpg";
import phAlexandreBouillon from "../../assets/photos/equipe/alexandre-bouillon.jpg";

export function getStaticPaths() {
  return PAGES_MUNICIPALES.map((p) => ({ params: { municipalite: p.slug }, props: { page: p } }));
}

interface Props {
  page: PageMunicipale;
}
const { page } = Astro.props;
const mrc = MRC_INFO[page.mrc];
const travaux = travauxTries(page);
const dominante = travaux[0][0];
const principaux = travaux.slice(0, 4);
const max = principaux[0][1];
const proches = voisines(page);
const agence = AGENCES.find((a) => a.nom === mrc.agence);

// La photo d'en-tête suit le travail le plus fréquent dans la municipalité.
const photos: Record<FamilleTravaux, ImageMetadata> = {
  recolte: recolteBois,
  feuillus: erabliere,
  recuperation: recolteHiver,
  eclaircieCom: peuplement,
  eclairciePrecom: peuplement,
  reboisement: plantationErables,
  degagement: plantationErables,
  paf: planAmenagement,
};

// Équipe Rive nord, telle que présentée sur /notre-equipe/ (mêmes ancres).
const EQUIPE: Record<string, { nom: string; titre: string; role: string; photo: ImageMetadata }> = {
  "simon-proulx": { nom: "Simon Proulx", titre: "ing.f.", role: "Ingénieur forestier, surtout dans la région de Québec", photo: phSimonProulx },
  "christian-dumont": { nom: "Christian Dumont", titre: "tech.f.", role: "Technicien forestier, installé dans Portneuf", photo: phChristianDumont },
  "jean-benoit-girard": { nom: "Jean-Benoît Girard", titre: "tech.f.", role: "Technicien forestier, préparation des récoltes", photo: phJeanBenoitGirard },
  "alexandre-bouillon": { nom: "Alexandre Bouillon", titre: "tech.f.", role: "Technicien forestier, région de Québec", photo: phAlexandreBouillon },
};

const dansLaMrc = page.mrc === "Québec" ? "l'agglomération de Québec" : `la MRC de ${page.mrc}`;
const etiquetteMrc = page.mrc === "Québec" ? "Agglomération de Québec" : `MRC de ${page.mrc}`;
// La MRC entre parenthèses aide à distinguer les homonymes, mais seulement si
// le titre reste lisible en entier dans Google (environ 65 caractères).
const titreCourt = `Ingénieur forestier à ${page.nom} | CFRQ`;
const titreLong = `Ingénieur forestier à ${page.nom} (${page.mrc}) | CFRQ`;
const titre = page.nom === page.mrc || page.mrc === "Québec" || titreLong.length > 65 ? titreCourt : titreLong;
const description = `Boisé à ${page.nom} ? CFRQ y a préparé ${page.dossiers} dossiers forestiers depuis ${page.depuis}, surtout en ${FAMILLES[dominante].titre.toLowerCase()}. Visite sans engagement.`;

const faq = [
  {
    q: `Ai-je droit à de l'aide financière pour mon boisé à ${page.nom} ?`,
    r: `Si votre boisé fait au moins 4 hectares, un plan d'aménagement forestier préparé par un ingénieur forestier vous permet d'être reconnu producteur forestier. Ce statut ouvre l'accès au Programme d'aide à la mise en valeur des forêts privées, géré à ${page.nom} par l'${mrc.agence}, et au remboursement de 85 % des taxes foncières admissibles. CFRQ est accrédité par cette agence et monte le dossier pour vous.`,
  },
  {
    q: `Faut-il un permis pour couper des arbres à ${page.nom} ?`,
    r: `Souvent, oui. Selon la municipalité et ${dansLaMrc}, l'abattage d'arbres peut exiger un permis, et parfois une prescription signée par un ingénieur forestier. Nous vérifions la réglementation qui s'applique à votre propriété et préparons les documents demandés avant les travaux.`,
  },
  {
    q: `Vous déplacez-vous jusqu'à ${page.nom} ?`,
    r: `Oui. Un membre de notre équipe vient marcher votre boisé avec vous, écoute vos objectifs et vous explique ce qu'il voit. La visite-conseil est sans engagement.`,
  },
];

const urlPage = `${SITE_PRODUCTION}/ingenieur-forestier/${page.slug}/`;
const ld = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": `${urlPage}#webpage`,
      url: urlPage,
      name: titre,
      description,
      inLanguage: "fr-CA",
      about: { "@id": `${SITE_PRODUCTION}/#organization` },
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Accueil", item: `${SITE_PRODUCTION}/` },
        { "@type": "ListItem", position: 2, name: "Ingénieur forestier par municipalité", item: `${SITE_PRODUCTION}/ingenieur-forestier/` },
        { "@type": "ListItem", position: 3, name: page.nom, item: urlPage },
      ],
    },
    {
      "@type": "Service",
      "@id": `${urlPage}#service`,
      name: `Ingénieur forestier à ${page.nom}`,
      serviceType: "Services d'ingénieur forestier en forêt privée",
      provider: { "@id": `${SITE_PRODUCTION}/#organization` },
      areaServed: {
        "@type": "City",
        name: `${page.nom}, Québec, Canada`,
        containedInPlace: { "@type": "AdministrativeArea", name: `${etiquetteMrc}, ${mrc.region}, Québec, Canada` },
      },
      hasOfferCatalog: {
        "@type": "OfferCatalog",
        name: `Travaux forestiers à ${page.nom}`,
        itemListElement: travaux.map(([f]) => ({ "@type": "Offer", itemOffered: { "@type": "Service", name: FAMILLES[f].titre } })),
      },
    },
  ],
};

const eyebrow = "text-[12.5px] font-semibold uppercase tracking-[0.18em]";
---

<Base title={titre} description={description} canonical={`/ingenieur-forestier/${page.slug}/`}>
  <script type="application/ld+json" set:html={JSON.stringify(ld)} slot="head" />

  <Header />
  <main id="contenu">
    <!-- HERO -->
    <section class="relative isolate overflow-hidden bg-[#16200f]">
      <EnteteImage src={photos[dominante]} alt={`Boisé privé : ${FAMILLES[dominante].titre.toLowerCase()}`} ratioDesktop={3} class="absolute inset-0 -z-10 h-full w-full object-cover" />
      <div class="absolute inset-0 -z-10" style="background:linear-gradient(120deg,rgba(15,22,10,.9) 0%,rgba(15,22,10,.68) 55%,rgba(15,22,10,.32) 100%)"></div>
      <div class="mx-auto max-w-[1160px] px-[22px] py-[84px]">
        <div class="max-w-[660px]">
          <nav aria-label="Fil d'Ariane" class="text-[13px] text-[#c9d2bc]">
            <a href={withBase("/ingenieur-forestier")} class="hover:underline">Par municipalité</a>
            <span class="px-1.5">/</span>
            <span>{etiquetteMrc}</span>
          </nav>
          <h1 class="mt-3 font-display font-medium text-cfrq-cream text-[clamp(34px,5.5vw,52px)] leading-[1.05] tracking-[-0.02em] text-balance">
            Ingénieur forestier à {page.nom}
          </h1>
          <p class="mt-4 text-[19px] leading-[1.5] text-[#dce2d2] text-pretty">
            Un boisé à {page.nom} ? Notre équipe d'ingénieurs et de techniciens forestiers y travaille déjà : plan d'aménagement, travaux, récolte et aide financière.
          </p>
          <div class="mt-7 flex flex-wrap items-center gap-4">
            <a href={withBase("/contact")} class="inline-flex items-center rounded-xl bg-cfrq-green px-6 py-3.5 text-[16px] font-bold text-[#123005] transition-colors hover:bg-[#6ecb3e]">Réserver une visite-conseil</a>
            <a href={site.telHref} class="text-[16px] font-semibold text-cfrq-cream hover:underline">{site.tel}</a>
          </div>
        </div>
      </div>
    </section>

    <!-- CHIFFRES -->
    <section class="border-b border-black/5 bg-white">
      <div class="mx-auto grid max-w-[1160px] gap-6 px-[22px] py-9 sm:grid-cols-3">
        <div>
          <p class="font-display text-[40px] font-medium leading-none text-cfrq-deep">{page.dossiers}</p>
          <p class="mt-2 text-[14.5px] leading-snug text-cfrq-ink/70">dossiers forestiers à {page.nom} depuis {page.depuis}</p>
        </div>
        <div>
          <p class="font-display text-[40px] font-medium leading-none text-cfrq-deep">{site.depuis}</p>
          <p class="mt-2 text-[14.5px] leading-snug text-cfrq-ink/70">l'année où CFRQ a commencé à accompagner les propriétaires de boisés</p>
        </div>
        <div>
          <p class="font-display text-[40px] font-medium leading-none text-cfrq-deep">6</p>
          <p class="mt-2 text-[14.5px] leading-snug text-cfrq-ink/70">agences régionales qui accréditent CFRQ, dont l'{mrc.agence}</p>
        </div>
      </div>
    </section>

    <!-- TRAVAUX -->
    <section class="mx-auto grid max-w-[1160px] gap-12 px-[22px] py-[72px] md:grid-cols-[1.3fr_1fr]">
      <div>
        <p class={`${eyebrow} text-cfrq-leaf`}>Nos travaux à {page.nom}</p>
        <h2 class="mt-3 font-display text-[clamp(26px,3.6vw,34px)] font-medium leading-[1.1] text-cfrq-deep text-balance">Ce qu'on fait dans les boisés de {page.nom}</h2>
        <p class="mt-5 text-[17px] leading-[1.7] text-cfrq-ink/[.78]">
          À {page.nom}, {PROFIL[dominante]} Voici les travaux qui reviennent le plus souvent dans nos dossiers.
        </p>

        <ul class="mt-7 space-y-5">
          {principaux.map(([f, n]) => (
            <li class="rounded-[16px] border border-black/5 bg-white p-5">
              <div class="flex items-baseline justify-between gap-4">
                <h3 class="font-display text-[18px] font-medium text-cfrq-deep">
                  <a href={withBase(FAMILLES[f].lien)} class="hover:underline">{FAMILLES[f].titre}</a>
                </h3>
                <span class="flex-none text-[14px] font-semibold text-cfrq-leaf">{n} {n > 1 ? "dossiers" : "dossier"}</span>
              </div>
              <div class="mt-3 h-1.5 rounded-full bg-[#eef2e6]" aria-hidden="true">
                <div class="h-1.5 rounded-full bg-cfrq-green" style={`width:${Math.max(8, Math.round((n / max) * 100))}%`}></div>
              </div>
              <p class="mt-3 text-[15px] leading-[1.6] text-cfrq-ink/70">{FAMILLES[f].texte}</p>
            </li>
          ))}
        </ul>
        <p class="mt-5 text-[13px] leading-[1.55] text-cfrq-ink/50">
          Prescriptions sylvicoles, plans d'aménagement et visites-conseils préparés par CFRQ pour des boisés situés à {page.nom}, de {page.depuis} à {ANNEE_DONNEES}. Un même dossier peut compter plusieurs types de travaux. Source : base de données de CFRQ.
        </p>
      </div>

      <aside class="space-y-6">
        <div class="rounded-[18px] border border-cfrq-green/[.14] bg-[#eef2e6] p-6">
          <h2 class="font-display text-[19px] font-medium text-cfrq-deep">Votre boisé dans {dansLaMrc}</h2>
          <p class="mt-3 text-[15px] leading-[1.6] text-cfrq-ink">{mrc.contexte}</p>
        </div>
        <div class="rounded-[18px] bg-cfrq-deep p-6 text-cfrq-cream">
          <h2 class="font-display text-[19px] font-medium">Aménager, ce n'est pas couper à blanc</h2>
          <p class="mt-2 text-[15px] leading-relaxed text-cfrq-cream/80">
            C'est prendre soin de votre forêt pour qu'elle reste en santé, prenne de la valeur et se transmette. On part de vos objectifs, pas d'une recette.
          </p>
          <a href={withBase("/contact")} class="mt-4 inline-flex rounded-[11px] bg-cfrq-green px-5 py-3 text-[15px] font-semibold text-[#123005] transition-colors hover:bg-cfrq-green-hover">
            Réserver une visite-conseil
          </a>
        </div>
      </aside>
    </section>

    <!-- ÉQUIPE -->
    <section class="border-t border-black/5 bg-white/60">
      <div class="mx-auto max-w-[1160px] px-[22px] py-[64px]">
        <p class={`${eyebrow} text-cfrq-leaf`}>Votre équipe</p>
        <h2 class="mt-3 font-display text-[clamp(26px,3.6vw,34px)] font-medium leading-[1.1] text-cfrq-deep text-balance">Les gens qui viennent marcher votre boisé</h2>
        <p class="mt-4 max-w-[640px] text-[16px] leading-[1.65] text-cfrq-ink/70">
          Notre équipe Rive nord couvre {page.nom} et les environs, et se déplace d'un secteur à l'autre selon vos besoins.
        </p>
        <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
          {mrc.equipe.map((id) => {
            const m = EQUIPE[id];
            return (
              <a href={withBase(`/notre-equipe`) + `#${id}`} class="group flex items-center gap-4 rounded-[16px] border border-black/5 bg-white p-4 transition-colors hover:border-cfrq-green/40">
                <Image src={m.photo} alt={`${m.nom}, ${m.titre}`} widths={[128]} sizes="64px" class="h-16 w-16 flex-none rounded-full object-cover" />
                <div>
                  <p class="font-display text-[16.5px] font-medium text-cfrq-deep group-hover:underline">{m.nom}, {m.titre}</p>
                  <p class="mt-1 text-[13.5px] leading-snug text-cfrq-ink/65">{m.role}</p>
                </div>
              </a>
            );
          })}
        </div>
      </div>
    </section>

    <!-- AIDE FINANCIÈRE ET FAQ -->
    <section class="mx-auto grid max-w-[1160px] gap-12 px-[22px] py-[72px] md:grid-cols-[1fr_1.2fr]">
      <div>
        <p class={`${eyebrow} text-cfrq-leaf`}>Aide financière</p>
        <h2 class="mt-3 font-display text-[clamp(26px,3.6vw,34px)] font-medium leading-[1.1] text-cfrq-deep text-balance">Des programmes existent. On vous montre lesquels.</h2>
        <p class="mt-5 text-[16px] leading-[1.7] text-cfrq-ink/[.78]">
          À {page.nom}, l'aide aux travaux en forêt privée passe par
          {agence?.url ? <a href={agence.url} target="_blank" rel="noopener" class="font-medium text-cfrq-deep underline decoration-cfrq-green/50 underline-offset-2 hover:decoration-cfrq-green">l'{mrc.agence}</a> : <span>l'{mrc.agence}</span>}.
          CFRQ y est accrédité : on prépare le plan, on monte les demandes et on s'occupe de la paperasse.
        </p>
        <ul class="mt-6 space-y-3">
          <li class="flex items-start gap-3 text-[15px] leading-snug">
            <span class="mt-[7px] h-[7px] w-[7px] flex-none rounded-full bg-cfrq-green"></span>
            <span>Estimez votre <a href={withBase("/calculateur-taxes-foncieres")} class="font-medium text-cfrq-deep underline decoration-cfrq-green/50 underline-offset-2">remboursement de taxes foncières</a>.</span>
          </li>
          <li class="flex items-start gap-3 text-[15px] leading-snug">
            <span class="mt-[7px] h-[7px] w-[7px] flex-none rounded-full bg-cfrq-green"></span>
            <span>Estimez la <a href={withBase("/calculateur-valeur-bois")} class="font-medium text-cfrq-deep underline decoration-cfrq-green/50 underline-offset-2">valeur du bois de votre boisé</a>.</span>
          </li>
        </ul>
      </div>

      <div>
        <h2 class="font-display text-[22px] font-medium text-cfrq-deep">Questions fréquentes à {page.nom}</h2>
        <div class="mt-5 divide-y divide-black/10 border-y border-black/10">
          {faq.map((item) => (
            <details class="group py-4">
              <summary class="flex cursor-pointer list-none items-start justify-between gap-4 text-[16px] font-medium text-cfrq-deep">
                {item.q}
                <span class="mt-0.5 flex-none text-cfrq-leaf transition-transform group-open:rotate-45" aria-hidden="true">+</span>
              </summary>
              <p class="mt-3 text-[15px] leading-[1.65] text-cfrq-ink/75">{item.r}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- AILLEURS -->
    <section class="border-t border-black/5 bg-white/60">
      <div class="mx-auto max-w-[1160px] px-[22px] py-[56px]">
        <h2 class="font-display text-[22px] font-medium text-cfrq-deep">
          {proches.length > 0 ? `Ailleurs dans ${dansLaMrc}` : "Ailleurs dans la région"}
        </h2>
        <div class="mt-5 flex flex-wrap gap-2.5">
          {proches.map((q) => (
            <a href={withBase(`/ingenieur-forestier/${q.slug}`)} class="rounded-full border border-cfrq-green/25 bg-white px-4 py-[9px] text-[14.5px] font-medium text-cfrq-deep transition-colors hover:border-cfrq-green">{q.nom}</a>
          ))}
          <a href={withBase("/ingenieur-forestier")} class="rounded-full border border-dashed border-cfrq-green/40 bg-[#eef2e6] px-4 py-[9px] text-[14.5px] font-semibold text-[#2e6b1e] hover:border-cfrq-green">Toutes les municipalités →</a>
        </div>
      </div>
    </section>

    <!-- CTA FINAL -->
    <section class="mx-auto max-w-[1160px] px-[22px] py-[72px]">
      <div class="flex flex-wrap items-center justify-between gap-6 rounded-3xl px-[clamp(30px,5vw,52px)] py-[clamp(30px,5vw,52px)] text-cfrq-cream" style="background:linear-gradient(140deg,#1D4011,#14331A)">
        <div class="flex-1 basis-[380px]">
          <h2 class="font-display text-[clamp(28px,4vw,40px)] font-medium leading-[1.08] text-balance">Un projet pour votre boisé à {page.nom} ?</h2>
          <p class="mt-3 max-w-[440px] text-[17px] leading-[1.55] text-cfrq-cream/[.82]">Une visite-conseil, c'est le meilleur point de départ. Sans engagement.</p>
        </div>
        <div class="flex flex-wrap items-center gap-3.5 md:flex-none">
          <a href={withBase("/contact")} class="inline-flex items-center rounded-xl bg-cfrq-green px-[26px] py-[15px] text-[16px] font-bold text-[#123005] transition-colors hover:bg-[#6ecb3e]">Réserver une visite-conseil</a>
          <p class="text-[16px] text-cfrq-cream/85">ou&nbsp;<a href={site.telHref} class="font-semibold text-white hover:underline">{site.tel}</a></p>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Base>
