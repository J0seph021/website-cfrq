---
import EnteteImage from "../../components/EnteteImage.astro";
import Base from "../../layouts/Base.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { site } from "../../data/site";
import { withBase } from "../../lib/url";
import { SITE_PRODUCTION } from "../../data/flags";
import { SECTEURS, REGIONS, ancre } from "../../data/secteurs";
import territoire from "../../assets/photos/territoire.jpg";

// Page d'entrée des pages par secteur : elle leur donne un lien depuis le pied
// de page (donc depuis toutes les pages du site), ce qui permet à Google de
// les découvrir sans dépendre du seul sitemap. Chaque municipalité pointe vers
// son ancre dans la page de son secteur.
const groupes = REGIONS.map((region) => ({ region, secteurs: SECTEURS.filter((s) => s.region === region) })).filter((g) => g.secteurs.length);

const titre = "Ingénieur forestier près de chez vous | CFRQ";
const description =
  "De Québec à la Beauce et aux Bois-Francs : les travaux forestiers de CFRQ par secteur, les municipalités où l'on travaille et l'équipe qui s'y déplace.";

const url = `${SITE_PRODUCTION}/ingenieur-forestier/`;
const ld = {
  "@context": "https://schema.org",
  "@graph": [
    { "@type": "WebPage", "@id": `${url}#webpage`, url, name: titre, description, inLanguage: "fr-CA", about: { "@id": `${SITE_PRODUCTION}/#organization` } },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Accueil", item: `${SITE_PRODUCTION}/` },
        { "@type": "ListItem", position: 2, name: "Ingénieur forestier par secteur", item: url },
      ],
    },
    {
      "@type": "ItemList",
      itemListElement: SECTEURS.map((s, i) => ({
        "@type": "ListItem",
        position: i + 1,
        name: `Ingénieur forestier ${s.dans}`,
        url: `${SITE_PRODUCTION}/ingenieur-forestier/${s.slug}/`,
      })),
    },
  ],
};

const eyebrow = "text-[12.5px] font-semibold uppercase tracking-[0.18em]";
---

<Base title={titre} description={description} canonical="/ingenieur-forestier/">
  <script type="application/ld+json" set:html={JSON.stringify(ld)} slot="head" />

  <Header />
  <main id="contenu">
    <section class="relative isolate overflow-hidden bg-[#16200f]">
      <EnteteImage src={territoire} alt="Forêt privée du territoire desservi par CFRQ" ratioDesktop={3.4} class="absolute inset-0 -z-10 h-full w-full object-cover" />
      <div class="absolute inset-0 -z-10" style="background:linear-gradient(120deg,rgba(15,22,10,.9) 0%,rgba(15,22,10,.62) 60%,rgba(15,22,10,.28) 100%)"></div>
      <div class="mx-auto max-w-[1160px] px-[22px] py-[84px]">
        <div class="max-w-[660px]">
          <p class={`${eyebrow} tracking-[0.2em] text-cfrq-green-light`}>Par secteur</p>
          <h1 class="mt-3 font-display font-medium text-cfrq-cream text-[clamp(34px,5.5vw,52px)] leading-[1.05] tracking-[-0.02em] text-balance">
            Un ingénieur forestier près de chez vous
          </h1>
          <p class="mt-5 max-w-[560px] text-[19px] leading-[1.55] text-[#dce2d2] text-pretty">
            Choisissez le secteur de votre boisé : vous verrez les travaux qu'on y fait, les municipalités où l'on travaille et l'équipe qui s'y déplace.
          </p>
        </div>
      </div>
    </section>

    {groupes.map((g) => (
      <section class="mx-auto max-w-[1160px] px-[22px] pt-[56px] last-of-type:pb-4">
        <h2 class="font-display text-[clamp(24px,3.4vw,30px)] font-medium text-cfrq-deep">{g.region}</h2>
        <div class="mt-5 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
          {g.secteurs.map((s) => (
            <div class="rounded-2xl border border-black/5 bg-white p-6">
              <h3 class="font-display text-[20px] font-medium">
                <a href={withBase(`/ingenieur-forestier/${s.slug}`)} class="text-cfrq-deep underline decoration-cfrq-green/40 underline-offset-4 hover:decoration-cfrq-green">{s.nom}</a>
              </h3>
              <p class="mt-3 text-[13.5px] leading-[1.7] text-cfrq-ink/65">
                {s.municipalites.map((m, i) => (
                  <Fragment>
                    <a href={withBase(`/ingenieur-forestier/${s.slug}`) + `#${ancre(m.nom)}`} class="hover:text-cfrq-deep hover:underline">{m.nom}</a>{i < s.municipalites.length - 1 ? " · " : ""}
                  </Fragment>
                ))}
              </p>
            </div>
          ))}
        </div>
      </section>
    ))}

    <section class="mx-auto max-w-[1160px] px-[22px] pt-[48px]">
      <p class="rounded-2xl border border-dashed border-cfrq-green/40 bg-[#eef2e6] p-6 text-[14.5px] leading-[1.6] text-[#2e6b1e]">
        Votre municipalité n'est pas dans la liste ? Ces listes montrent les endroits où nous avons déjà des dossiers, pas les limites de notre <a href={withBase("/territoire-desservi")} class="font-semibold underline">territoire</a>. <a href={withBase("/contact")} class="font-semibold underline">Écrivez-nous</a>, on vient voir votre boisé.
      </p>
    </section>

    <section class="mx-auto max-w-[1160px] px-[22px] py-[64px]">
      <div class="rounded-3xl px-[clamp(34px,5vw,56px)] py-[clamp(34px,5vw,56px)] text-center text-cfrq-cream" style="background:linear-gradient(140deg,#1D4011,#14331A)">
        <h2 class="font-display text-[clamp(28px,4.5vw,44px)] font-medium leading-[1.06] text-balance">Votre boisé mérite une visite</h2>
        <p class="mx-auto mt-4 max-w-[520px] text-[18px] leading-[1.55] text-cfrq-cream/[.82]">Un membre de notre équipe se déplace pour une visite-conseil, sans engagement.</p>
        <div class="mt-[30px] flex flex-wrap items-center justify-center gap-4">
          <a href={withBase("/contact")} class="inline-flex items-center rounded-xl bg-cfrq-green px-8 py-4 text-[16.5px] font-bold text-[#123005] transition-colors hover:bg-[#6ecb3e]">Réserver une visite-conseil</a>
          <p class="text-[16px] text-cfrq-cream/85">ou&nbsp;<a href={site.telHref} class="font-semibold text-cfrq-cream hover:underline">{site.tel}</a></p>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Base>
